# Pinned stb_truetype 1.26, MIT/public-domain dual license in the downloaded header.
# Cache lives in the build tree; applications may pre-seed it for offline builds.
set(PENGUI_TEXT_DEP_DIR "${PROJECT_BINARY_DIR}/text-deps" CACHE PATH "Cached text rasterizer headers")
set(_pui_stb "${PENGUI_TEXT_DEP_DIR}/stb_truetype.h")
if(NOT EXISTS "${_pui_stb}")
 file(MAKE_DIRECTORY "${PENGUI_TEXT_DEP_DIR}")
 # Retry transient HTTP/network failures; the pinned hash is still mandatory.
 foreach(_pui_attempt RANGE 1 3)
  file(DOWNLOAD "https://raw.githubusercontent.com/nothings/stb/f0569113c93ad095470c54bf34a17b36646bbbb5/stb_truetype.h"
   "${_pui_stb}.tmp" TLS_VERIFY ON TIMEOUT 30 INACTIVITY_TIMEOUT 10 STATUS _pui_download)
  list(GET _pui_download 0 _pui_code)
  if(_pui_code EQUAL 0)
   break()
  endif()
 endforeach()
 if(NOT _pui_code EQUAL 0)
  file(REMOVE "${_pui_stb}.tmp")
  message(FATAL_ERROR "Could not fetch pinned stb_truetype after 3 attempts; pre-seed PENGUI_TEXT_DEP_DIR for offline builds: ${_pui_download}")
 endif()
 file(SHA256 "${_pui_stb}.tmp" _pui_hash)
 if(NOT _pui_hash STREQUAL "ecd30b05e0dd4fea3a13c26810dd9e1992dc379049482c393d5a19e6b5090aab")
  file(REMOVE "${_pui_stb}.tmp")
  message(FATAL_ERROR "Unexpected downloaded stb_truetype hash")
 endif()
 file(RENAME "${_pui_stb}.tmp" "${_pui_stb}")
endif()
file(SHA256 "${_pui_stb}" _pui_hash)
if(NOT _pui_hash STREQUAL "ecd30b05e0dd4fea3a13c26810dd9e1992dc379049482c393d5a19e6b5090aab")
 message(FATAL_ERROR "Unexpected stb_truetype hash in ${PENGUI_TEXT_DEP_DIR}")
endif()
add_library(pengui_truetype STATIC "${PROJECT_SOURCE_DIR}/apps/demo/platform/truetype.c")
target_include_directories(pengui_truetype PUBLIC "${PENGUI_TEXT_DEP_DIR}")
if(NOT MSVC)
 target_link_libraries(pengui_truetype PUBLIC m)
endif()
