set(destination "${BINARY}/copy-example-test")
file(REMOVE_RECURSE "${destination}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${SOURCE}/examples/topdown"
    "-DDEST=${destination}" -P "${SOURCE}/cmake/CopyExample.cmake" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${destination}/assets/tiles.png")
    message(FATAL_ERROR "Example initialization failed")
endif()
file(WRITE "${destination}/project.json" "user-edited manifest")
file(WRITE "${destination}/scenes/room.json" "user-edited scene")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${SOURCE}/examples/topdown"
    "-DDEST=${destination}" -P "${SOURCE}/cmake/CopyExample.cmake" RESULT_VARIABLE result)
file(READ "${destination}/project.json" manifest)
file(READ "${destination}/scenes/room.json" scene)
if(NOT result EQUAL 0 OR NOT manifest STREQUAL "user-edited manifest" OR NOT scene STREQUAL "user-edited scene")
    message(FATAL_ERROR "Build overwrote user data")
endif()
file(REMOVE_RECURSE "${destination}")
