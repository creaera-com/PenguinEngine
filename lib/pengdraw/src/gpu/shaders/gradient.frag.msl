#include <metal_stdlib>
using namespace metal;
struct Input { float4 color [[user(locn0)]]; float2 uv [[user(locn1)]]; };
struct Parameters { float4 crop; float4 origin; float4 shape; float4 axis; float4 ends; float4 colors[8]; float4 positions[8]; };
fragment float4 main0(Input input [[stage_in]], constant Parameters &p [[buffer(0)]],
                      texture2d<float> image [[texture(0)]], sampler image_sampler [[sampler(0)]]) {
    float2 uv = input.uv;

    float2 pixel_position = (p.crop.xy + uv * p.crop.zw - p.origin.xy) / p.origin.z - p.shape.xy - p.shape.zw * 0.5;
    float2 local = float2(p.axis.x*pixel_position.x+p.axis.y*pixel_position.y, -p.axis.y*pixel_position.x+p.axis.x*pixel_position.y)+p.shape.zw*0.5;
    float2 delta = (p.ends.zw-p.ends.xy)*p.shape.zw;
    float2 offset = local-p.ends.xy*p.shape.zw;
    float length2 = dot(delta,delta);
    float t = length2 > 0.0 ? dot(offset,delta)/length2 : 0.0;
    if (p.origin.w > 1.5 && p.origin.w < 2.5) t = length2 > 0.0 ? length(offset)/sqrt(length2) : 0.0;
    else if (p.origin.w > 3.5) t = abs(t);
    else if (p.origin.w > 2.5) { t = (atan2(offset.y,offset.x)-atan2(delta.y,delta.x))/6.28318530718; t -= floor(t); }
    t = clamp(t,0.0,1.0);
    int end = 1;
    while (end+1 < int(p.axis.z) && t > p.positions[end].x) ++end;
    float u = (t-p.positions[end-1].x)/(p.positions[end].x-p.positions[end-1].x);
    float4 a = p.colors[end-1], b = p.colors[end];
    float alpha = a.a*(1.0-u)+b.a*u;
    float3 rgb = alpha > 0.0 ? (a.rgb*a.a*(1.0-u)+b.rgb*b.a*u)/alpha : float3(0.0,0.0,0.0);
    return float4(rgb,alpha);
}
