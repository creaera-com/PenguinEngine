PROJECT_NAME           = PenguinEngine
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "C17: pengUI, pengDraw und modulare Editoren"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
OUTPUT_LANGUAGE        = German
INPUT_ENCODING         = UTF-8
INPUT                  = "@PROJECT_SOURCE_DIR@/lib/pengui/include" "@PROJECT_SOURCE_DIR@/lib/pengdraw/include" "@PROJECT_SOURCE_DIR@/apps" "@PROJECT_SOURCE_DIR@/editors" "@PROJECT_SOURCE_DIR@/docs" "@PROJECT_SOURCE_DIR@/README.md" "@PROJECT_SOURCE_DIR@/AGENTS.md" "@PROJECT_SOURCE_DIR@/third_party/tabler-icons/README.md"
FILE_PATTERNS          = *.h *.dox *.md
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB

RECURSIVE              = YES
EXCLUDE                = "@PROJECT_SOURCE_DIR@/docs/doxygen/Doxyfile.in"
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
FULL_PATH_NAMES        = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = YES
WARN_LOGFILE           = "@CMAKE_BINARY_DIR@/doxygen-warnings.log"
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
JAVADOC_AUTOBRIEF      = NO
SORT_MEMBER_DOCS       = NO

# Doxygen Awesome, with persistent tree navigation and local Penguin accents.
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
TREEVIEW_WIDTH         = 335
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = "@PROJECT_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome.css" \
                         "@PROJECT_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-sidebar-only.css" \
                         "@PROJECT_SOURCE_DIR@/docs/doxygen/penguin-theme.css"

# Keep optional SDL APIs visible even when documentation is configured without SDL builds.
PREDEFINED             = PUI_WITH_SDL=1 PDRAW_WITH_SDL=1
