PROJECT_NAME           = PenguinEngine
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "C17/SDL3 Engine, Editor und wiederverwendbare UI"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
OUTPUT_LANGUAGE        = German
INPUT_ENCODING         = UTF-8
INPUT                  = "@PROJECT_SOURCE_DIR@/src" "@PROJECT_SOURCE_DIR@/docs/doxygen/mainpage.dox"
FILE_PATTERNS          = *.h *.dox
RECURSIVE              = YES
EXCLUDE                = "@PROJECT_SOURCE_DIR@/src/ui/rendering/font_atlas.h"
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
FULL_PATH_NAMES        = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = YES
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
JAVADOC_AUTOBRIEF      = NO
SORT_MEMBER_DOCS       = NO
